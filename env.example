NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pritzio
DATABASE_USER=pritzio_user
DATABASE_PASSWORD=pritzio_password
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pritzio_redis_password

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=pritzio-backend
JWT_AUDIENCE=pritzio-users

# Logging Configuration
LOG_LEVEL=debug
ENABLE_LOGGING=true
NESTJS_LOG_LEVELS=error,warn,log,debug,verbose
TYPEORM_LOGGING=true
ENABLE_SWAGGER=true

# Security Configuration
VALID_API_KEYS=pritzio-dev-key,pritzio-prod-key  # Comma-separated API keys for protected endpoints
SECURITY_LOG_LEVEL=info                          # Security logging level: error, warn, info, debug, verbose
ENABLE_SECURITY_LOGGING=true                     # Enable/disable security event logging
MAX_PAYLOAD_SIZE=10485760                        # Maximum request size in bytes (10MB)
RATE_LIMIT_WINDOW_MS=900000                      # Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_MAX_REQUESTS=100                      # Maximum requests per window per IP

BCRYPT_ROUNDS=12                                 # Password hashing rounds (10-14 recommended)

# Timezone Configuration
TIMEZONE=America/Santiago

