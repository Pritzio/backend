  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default timeout if not provided",
          "if (!pm.request.url.query.has('timeout')) {",
          "    pm.request.url.query.add({",
          "        key: 'timeout',",
          "        value: '30000'",
          "        enabled: true",
          "    });",
          "}",
          "",
          "// Log request details",
          "console.log('Scraping URL:', pm.request.url.query.get('url'));",
          "console.log('Timeout:', pm.request.url.query.get('timeout'));",
          "console.log('Wait Selector:', pm.request.url.query.get('waitForSelector'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts for scraping endpoints",
          "pm.test('Response status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);",
          "});",
          "",
          "pm.test('Response has required fields', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "    pm.expect(jsonData).to.have.property('url');",
          "    pm.expect(jsonData).to.have.property('timestamp');",
          "    pm.expect(jsonData).to.have.property('executionTime');",
          "});",
          "",
          "pm.test('Execution time is reasonable', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData.executionTime).to.be.a('number');",
          "    pm.expect(jsonData.executionTime).to.be.above(0);",
          "    pm.expect(jsonData.executionTime).to.be.below(120000); // Max 2 minutes",
          "});",
          "",
          "// Test success response",
          "if (pm.response.json().success) {",
          "    pm.test('Success response has HTML content', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('html');",
          "        pm.expect(jsonData.html).to.be.a('string');",
          "        pm.expect(jsonData.html.length).to.be.above(0);",
          "    });",
          "}",
          "",
          "// Test error response",
          "if (!pm.response.json().success) {",
          "    pm.test('Error response has error message', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('error');",
          "        pm.expect(jsonData.error).to.be.a('string');",
          "        pm.expect(jsonData.error.length).to.be.above(0);",
          "    });",
          "}",
          "",
          "// Log execution time",
          "const executionTime = pm.response.json().executionTime;",
          "console.log('Execution time:', executionTime + 'ms');",
          "",
          "// Log success/failure",
          "const success = pm.response.json().success;",
          "console.log('Scraping result:', success ? 'SUCCESS' : 'FAILED');",
          "",
          "if (success) {",
          "    const htmlLength = pm.response.json().html ? pm.response.json().html.length : 0;",
          "    console.log('HTML content length:', htmlLength + ' characters');",
          "} else {",
          "    console.log('Error:', pm.response.json().error);",
          "}"
        ]
      }
    }
  ]
}



