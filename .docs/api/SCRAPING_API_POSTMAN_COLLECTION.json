              "raw": "{{base_url}}/scrape?url=https://lider.cl/catalogo&timeout=60000&waitForSelector=.product-item",
              "host": ["{{base_url}}"],
              "path": ["scrape"],
              "query": [
                {
                  "key": "url",
                  "value": "https://lider.cl/catalogo"
                },
                {
                  "key": "timeout",
                  "value": "60000"
                },
                {
                  "key": "waitForSelector",
                  "value": ".product-item"
                }
              ]
            },
            "description": "Scrape e-commerce catalog page with product items"
          },
          "response": []
        },
        {
          "name": "Scrape URL - Long Timeout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scrape?url=https://santaisabel.cl/productos&timeout=90000&waitForSelector=.product-grid",
              "host": ["{{base_url}}"],
              "path": ["scrape"],
              "query": [
                {
                  "key": "url",
