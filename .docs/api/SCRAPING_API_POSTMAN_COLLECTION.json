                  "value": "90000"
                },
                {
                  "key": "waitForSelector",
                  "value": ".product-grid"
                }
              ]
            },
            "description": "Scrape URL with extended timeout for slow-loading sites"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health & Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
