  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default base product ID if not provided",
          "if (pm.request.url.path.includes('{{base_product_id}}') && pm.variables.get('base_product_id') === 'uuid-base-product-id-here') {",
          "    // You can set a real base product ID here for testing",
          "    pm.variables.set('base_product_id', 'your-actual-base-product-id-here');",
          "}",
          "",
          "// Log request details",
          "console.log('Request URL:', pm.request.url.toString());",
          "console.log('Request Method:', pm.request.method);",
          "if (pm.request.url.query.has('q')) {",
          "    console.log('Search Query:', pm.request.url.query.get('q'));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts for product comparison endpoints",
          "pm.test('Response status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404, 500]);",
          "});",
          "",
          "pm.test('Response has required structure', function () {",
          "    const jsonData = pm.response.json();",
          "    ",
          "    if (pm.request.url.path.includes('/search')) {",
          "        pm.expect(jsonData).to.have.property('data');",
          "        pm.expect(jsonData).to.have.property('total');",
          "        pm.expect(jsonData).to.have.property('query');",
          "        pm.expect(jsonData.data).to.be.an('array');",
          "    }",
          "    ",
          "    if (pm.request.url.path.includes('/search') && jsonData.data.length > 0) {",
          "        pm.test('Search results have required fields', function () {",
          "            const product = jsonData.data[0];",
          "            pm.expect(product).to.have.property('id');",
          "            pm.expect(product).to.have.property('name');",
          "            pm.expect(product).to.have.property('fullName');",
          "            pm.expect(product).to.have.property('storeCount');",
          "            pm.expect(product).to.have.property('totalVariants');",
          "        });",
          "    }",
          "    ",
          "    if (!pm.request.url.path.includes('/search')) {",
          "        pm.expect(jsonData).to.have.property('product');",
          "        pm.expect(jsonData).to.have.property('stores');",
          "        pm.expect(jsonData).to.have.property('priceRange');",
          "        pm.expect(jsonData).to.have.property('totalStores');",
          "    }",
          "});",
          "",
          "// Test search functionality",
          "if (pm.request.url.path.includes('/search')) {",
          "    pm.test('Search query validation', function () {",
          "        const jsonData = pm.response.json();",
          "        ",
          "        if (pm.response.code === 200) {",
          "            pm.expect(jsonData.query).to.be.a('string');",
          "            pm.expect(jsonData.query.length).to.be.at.least(2);",
          "        }",
          "    });",
          "    ",
          "    pm.test('Search results are relevant', function () {",
          "        const jsonData = pm.response.json();",
          "        ",
          "        if (jsonData.data.length > 0) {",
          "            const query = jsonData.query.toLowerCase();",
          "            const firstProduct = jsonData.data[0];",
          "            ",
          "            // Check if product name contains query terms",
          "            const productName = firstProduct.name.toLowerCase();",
          "            const fullName = firstProduct.fullName.toLowerCase();",
          "            ",
          "            pm.expect(productName.includes(query) || fullName.includes(query)).to.be.true;",
          "        }",
          "    });",
          "}",
          "",
          "// Test comparison functionality",
          "if (!pm.request.url.path.includes('/search')) {",
          "    pm.test('Product comparison has valid structure', function () {",
          "        const jsonData = pm.response.json();",
          "        ",
          "        if (pm.response.code === 200) {",
          "            pm.expect(jsonData.product).to.have.property('id');",
          "            pm.expect(jsonData.product).to.have.property('name');",
          "            pm.expect(jsonData.product).to.have.property('storeCount');",
          "            ",
          "            pm.expect(jsonData.priceRange).to.have.property('min');",
          "            pm.expect(jsonData.priceRange).to.have.property('max');",
          "            pm.expect(jsonData.priceRange).to.have.property('avg');",
          "            ",
          "            pm.expect(jsonData.stores).to.be.an('array');",
          "            pm.expect(jsonData.totalStores).to.be.a('number');",
          "        }",
          "    });",
          "    ",
          "    pm.test('Price range is valid', function () {",
          "        const jsonData = pm.response.json();",
          "        ",
          "        if (pm.response.code === 200 && jsonData.priceRange) {",
          "            pm.expect(jsonData.priceRange.min).to.be.at.most(jsonData.priceRange.max);",
          "            pm.expect(jsonData.priceRange.avg).to.be.at.least(jsonData.priceRange.min);",
          "            pm.expect(jsonData.priceRange.avg).to.be.at.most(jsonData.priceRange.max);",
          "        }",
          "    });",
          "    ",
          "    pm.test('Store data is valid', function () {",
          "        const jsonData = pm.response.json();",
          "        ",
          "        if (pm.response.code === 200 && jsonData.stores.length > 0) {",
          "            const store = jsonData.stores[0];",
          "            pm.expect(store).to.have.property('store');",
          "            pm.expect(store).to.have.property('product');",
          "            pm.expect(store).to.have.property('price');",
          "            ",
          "            pm.expect(store.store).to.have.property('id');",
          "            pm.expect(store.store).to.have.property('name');",
          "            ",
          "            pm.expect(store.product).to.have.property('id');",
          "            pm.expect(store.product).to.have.property('name');",
          "            pm.expect(store.product).to.have.property('price');",
          "        }",
          "    });",
          "}",
          "",
          "// Log response summary",
          "const jsonData = pm.response.json();",
          "console.log('Response Status:', pm.response.code);",
          "",
          "if (pm.request.url.path.includes('/search')) {",
          "    console.log('Search Results:', jsonData.total || 0);",
          "    console.log('Query:', jsonData.query || 'N/A');",
          "} else {",
          "    console.log('Comparison Stores:', jsonData.totalStores || 0);",
          "    if (jsonData.priceRange) {",
          "        console.log('Price Range: $' + jsonData.priceRange.min + ' - $' + jsonData.priceRange.max);",
          "    }",
          "}"
        ]
      }
    }
  ]
